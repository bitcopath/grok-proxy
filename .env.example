# =============================================================================
# Grok Proxy — copy this file to .env and fill in your own values.
# =============================================================================

# Host port on your Docker server where the proxy will be reachable.
# Pick any free port. If something else already uses 8084, choose 8085, 9002, etc.
SERVER_PORT=8084

# Path on the Docker HOST where Grok Build stores its login/auth and config.
# Inside the container this is mounted to /root/.grok.
# How to find yours:
#   - Linux/WSL:   /home/YOUR_USERNAME/.grok
#   - macOS:       /Users/YOUR_USERNAME/.grok
#   - Windows:     C:\Users\YOUR_USERNAME\.grok  (use WSL or Docker Desktop path)
HOST_GROK_PATH=/home/YOUR_USERNAME/.grok

# Timeout for one Grok CLI call in milliseconds (5 minutes default).
GROK_TIMEOUT_MS=300000

# Cap how many tool/agent steps Grok can take in one request.
GROK_MAX_TURNS=8

# Headless tool runs inside the container need permission bypass.
# SECURITY: keep this on your private LAN only; do not expose to the internet.
GROK_PERMISSION_MODE=bypassPermissions

# Optional: free local model fallback (OpenAI-compatible endpoint on your LAN).
# Example: http://your-main-pc:8080/v1
# Leave empty to disable the local-qwen provider.
LOCAL_AI_BASE_URL=

# Optional: file containing the API key for the local model endpoint.
# Leave empty if your local endpoint does not require a key.
LOCAL_AI_API_KEY_FILE=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# SECURITY: only set this to true while troubleshooting.
# When true, full prompts and AI responses are written to the log file.
LOG_SENSITIVE=false
